# Dépendances
# Le dossier node_modules est généré par `npm install` et ne doit jamais être versionné.
/node_modules

# Fichiers de log
logs
*.log
npm-debug.log*
yarn-debug.log*

# Fichiers temporaires locaux
temp/
tmp/

# PDFs temporaires (mais pas ceux générés par le build)
*.pdf
!dist/fiches/*.pdf

