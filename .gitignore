# Dépendances
# Le dossier node_modules est généré par `npm install` et ne doit jamais être versionné.
/node_modules

# Fichiers de log
logs
*.log
npm-debug.log*
yarn-debug.log*

# Fichiers temporaires locaux
temp/
tmp/
# Numéro de processus du serveur local, propre à chaque ordinateur
server.pid

# Site statique généré par `npm run build` : le workflow le refait à chaque
# envoi sur main et le publie sur la branche gh-pages. Il n'est pas versionné.
/dist/

# PDF temporaires
*.pdf

# Other files
TODO.md

# Fichiers générés par le système d'exploitation
.DS_Store
Thumbs.db

# IA files
.aiexclude
